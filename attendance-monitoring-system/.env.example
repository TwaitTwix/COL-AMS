# Server
NODE_ENV=development
PORT=3001
# Keeps the local app private to this computer. Do not change this unless you
# intentionally need to expose it on your local network.
HOST=127.0.0.1
PUBLIC_APP_URL=http://127.0.0.1:3001
# Optional stable signing secret (32+ random characters). Falls back to the
# server-only Supabase key; rotating it makes browser devices appear new.
# DEVICE_SIGNING_SECRET=

# Supabase (add values locally; never commit real credentials)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never expose this in frontend code.
SUPABASE_SECRET_KEY=
# Older project keys are supported if your project still uses the legacy names.
# SUPABASE_SERVICE_ROLE_KEY=

ATTENDANCE_REPORTS_BUCKET=attendance-reports
